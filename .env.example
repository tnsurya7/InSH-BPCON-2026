# Neon PostgreSQL Database Connection URL (Set your real connection string in Vercel or local .env)
DATABASE_URL=postgresql://neondb_owner:YOUR_DATABASE_PASSWORD@ep-your-endpoint.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT Secret Key for Session Authentication
JWT_SECRET=your-secure-jwt-secret-key-here

# System Administrator Account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-secure-admin-password

# Additional Admin Account
ADMIN_EMAIL_2=admin2@example.com
ADMIN_PASSWORD_2=your-secure-admin2-password

# Conference Staff Account
STAFF_EMAIL=staff@example.com
STAFF_PASSWORD=your-secure-staff-password

# Scanner Operator Account
SCANNER_EMAIL=scanner@example.com
SCANNER_PASSWORD=your-secure-scanner-password
